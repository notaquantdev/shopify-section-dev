<div
  class="benefits"
  style="
    --bg: {{ section.settings.bg_color }};
    --eyebrow: {{ section.settings.eyebrow_color }};
    --heading: {{ section.settings.heading_color }};
    --media-bg: {{ section.settings.media_bg_color }};
    --row-heading: {{ section.settings.row_heading_color }};
    --row-text: {{ section.settings.row_text_color }};
  "
>
  <div class="benefits__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="benefits__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="benefits__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="benefits__list">
      {% assign row_index = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          {% assign row_index = row_index | plus: 1 %}
          {% assign row_is_even = row_index | modulo: 2 %}
          <div class="benefits__row {% if row_is_even == 0 %}benefits__row--reverse{% endif %}" {{ block.shopify_attributes }}>
            <div class="benefits__media">
              {% if block.settings.image %}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'benefits__image' }}
              {% endif %}
            </div>
            <div class="benefits__text">
              <h3 class="benefits__row-heading">{{ block.settings.heading }}</h3>
              <p class="benefits__row-text">{{ block.settings.text }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .benefits {
    background: var(--bg);
    padding: 56px 24px;
    font-family: 'Work Sans', sans-serif;
  }

  .benefits__inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .benefits__eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--eyebrow);
    margin: 0 0 10px;
    text-align: center;
  }

  .benefits__heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    color: var(--heading);
    margin: 0 0 48px;
    line-height: 1.2;
    text-align: center;
  }

  .benefits__list {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .benefits__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .benefits__row--reverse .benefits__media {
    order: 2;
  }

  .benefits__media {
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--media-bg);
  }

  .benefits__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .benefits__row-heading {
    font-family: 'Fraunces', serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--row-heading);
    margin: 0 0 12px;
  }

  .benefits__row-text {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--row-text);
    margin: 0;
    max-width: 380px;
  }

  @media (max-width: 749px) {
    .benefits { padding: 20px 16px; }
    .benefits__heading { margin-bottom: 32px; }
    .benefits__list { gap: 32px; }
    .benefits__row {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .benefits__row--reverse .benefits__media {
      order: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Benefits",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why dog parents love it" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More than a harness." },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFF9F2" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow text", "default": "#B5764C" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#3E2F23" },
    { "type": "color", "id": "media_bg_color", "label": "Image placeholder background", "default": "#EFE3D3" },
    { "type": "color", "id": "row_heading_color", "label": "Row heading", "default": "#3E2F23" },
    { "type": "color", "id": "row_text_color", "label": "Row description", "default": "#6B5842" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Calm walks, finally" },
        { "type": "text", "id": "text", "label": "Description", "default": "The even pressure means no more choking or gasping — just a relaxed dog enjoying the walk." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "heading": "Calm walks, finally", "text": "The even pressure means no more choking or gasping — just a relaxed dog enjoying the walk." } },
        { "type": "benefit", "settings": { "heading": "Built for real life", "text": "Machine-washable mesh handles mud, rain, and everyday adventures without falling apart." } },
        { "type": "benefit", "settings": { "heading": "Safe after dark", "text": "Reflective stitching keeps your dog visible on early mornings and evening walks." } }
      ]
    }
  ]
}
{% endschema %}