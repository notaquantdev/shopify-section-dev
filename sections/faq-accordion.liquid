<div class="faq-accordion">
  <div class="faq-accordion__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="faq-accordion__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="faq-accordion__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="faq-accordion__list">
      {% for block in section.blocks %}
        {% if block.type == 'faq' %}
          <details class="faq-accordion__item" {{ block.shopify_attributes }}>
            <summary class="faq-accordion__question">
              {{ block.settings.question }}
              <span class="faq-accordion__icon">+</span>
            </summary>
            <div class="faq-accordion__answer">{{ block.settings.answer }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .faq-accordion {
    background: #FFF9F2;
    padding: 56px 24px;
    font-family: 'Work Sans', sans-serif;
  }

  .faq-accordion__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .faq-accordion__eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #B5764C;
    margin: 0 0 10px;
    text-align: center;
  }

  .faq-accordion__heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    color: #3E2F23;
    margin: 0 0 36px;
    line-height: 1.2;
    text-align: center;
  }

  .faq-accordion__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-accordion__item {
    background: #fff;
    border-radius: 14px;
    padding: 18px 22px;
  }

  .faq-accordion__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 15.5px;
    font-weight: 700;
    color: #3E2F23;
    cursor: pointer;
    list-style: none;
  }

  .faq-accordion__question::-webkit-details-marker {
    display: none;
  }

  .faq-accordion__icon {
    flex-shrink: 0;
    font-size: 20px;
    font-weight: 400;
    color: #D97B4F;
    transition: transform 0.2s ease;
  }

  .faq-accordion__item[open] .faq-accordion__icon {
    transform: rotate(45deg);
  }

  .faq-accordion__answer {
    font-size: 14.5px;
    line-height: 1.6;
    color: #6B5842;
    margin-top: 12px;
  }

  @media (max-width: 749px) {
    .faq-accordion { padding: 20px 16px; }
    .faq-accordion__heading { margin-bottom: 24px; }
  }
</style>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Still have questions?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What sizes are available?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "SnugWalk comes in 5 sizes from XS to XL, fitting breeds from Chihuahuas to Labradors. Check our size chart for exact measurements." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "faq", "settings": { "question": "What sizes are available?", "answer": "SnugWalk comes in 5 sizes from XS to XL, fitting breeds from Chihuahuas to Labradors. Check our size chart for exact measurements." } },
        { "type": "faq", "settings": { "question": "Is it machine washable?", "answer": "Yes — the mesh fabric can go straight into the washing machine on a gentle cold cycle. Air dry only." } },
        { "type": "faq", "settings": { "question": "Will it really stop pulling?", "answer": "It won't eliminate pulling overnight, but the front-clip design redirects your dog's momentum sideways, making it much easier to correct and discourage." } },
        { "type": "faq", "settings": { "question": "What's your return policy?", "answer": "We offer a 30-day money-back guarantee, no questions asked. If it's not the right fit, just reach out." } },
        { "type": "faq", "settings": { "question": "How long does shipping take?", "answer": "Orders ship within 1-2 business days and typically arrive in 3-5 business days." } }
      ]
    }
  ]
}
{% endschema %}