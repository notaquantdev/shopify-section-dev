<div
  class="feature-ticker"
  style="
    --bg: {{ section.settings.bg_color }};
    --text: {{ section.settings.text_color }};
    --dot: {{ section.settings.dot_color }};
  "
>
  <div class="feature-ticker__track" style="animation-duration: {{ section.settings.speed }}s;">
    <div class="feature-ticker__group">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <span class="feature-ticker__item">{{ block.settings.icon }} {{ block.settings.text }}</span>
        {% endif %}
      {% endfor %}
    </div>
    <div class="feature-ticker__group" aria-hidden="true">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <span class="feature-ticker__item">{{ block.settings.icon }} {{ block.settings.text }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .feature-ticker {
    background: var(--bg);
    padding: 14px 0;
    overflow: hidden;
    font-family: 'Work Sans', sans-serif;
  }

  .feature-ticker__track {
    display: flex;
    width: max-content;
    animation-name: tickerScroll;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .feature-ticker__group {
    display: flex;
    align-items: center;
  }

  .feature-ticker__item {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
    padding: 0 28px;
    position: relative;
  }

  .feature-ticker__item::after {
    content: "•";
    position: absolute;
    right: 0;
    color: var(--dot);
  }

  @keyframes tickerScroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (max-width: 749px) {
    .feature-ticker { padding: 20px 0; }
  }
</style>

{% schema %}
{
  "name": "Feature Ticker",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F4D9B8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#6B4B2F" },
    { "type": "color", "id": "dot_color", "label": "Dot separator", "default": "#D97B4F" },

    { "type": "header", "content": "Animation" },
    { "type": "range", "id": "speed", "label": "Scroll speed (seconds — lower is faster)", "min": 8, "max": 40, "step": 1, "default": 22 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "🐾" },
        { "type": "text", "id": "text", "label": "Text", "default": "No-Pull Design" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Feature Ticker",
      "blocks": [
        { "type": "item", "settings": { "icon": "🐾", "text": "No-Pull Design" } },
        { "type": "item", "settings": { "icon": "🧼", "text": "Machine Washable" } },
        { "type": "item", "settings": { "icon": "🌙", "text": "Reflective Strips" } },
        { "type": "item", "settings": { "icon": "📏", "text": "Fits XS–XL" } },
        { "type": "item", "settings": { "icon": "✅", "text": "30-Day Guarantee" } }
      ]
    }
  ]
}
{% endschema %}