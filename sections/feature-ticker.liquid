<div class="feature-ticker">
  <div class="feature-ticker__track">
    <div class="feature-ticker__group">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <span class="feature-ticker__item">{{ block.settings.icon }} {{ block.settings.text }}</span>
        {% endif %}
      {% endfor %}
    </div>
    <div class="feature-ticker__group" aria-hidden="true">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
          <span class="feature-ticker__item">{{ block.settings.icon }} {{ block.settings.text }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .feature-ticker {
    background: #F4D9B8;
    padding: 14px 0;
    overflow: hidden;
    font-family: 'Work Sans', sans-serif;
  }

  .feature-ticker__track {
    display: flex;
    width: max-content;
    animation: tickerScroll 22s linear infinite;
  }

  .feature-ticker__group {
    display: flex;
    align-items: center;
  }

  .feature-ticker__item {
    font-size: 14px;
    font-weight: 700;
    color: #6B4B2F;
    white-space: nowrap;
    padding: 0 28px;
    position: relative;
  }

  .feature-ticker__item::after {
    content: "•";
    position: absolute;
    right: 0;
    color: #D97B4F;
  }

  @keyframes tickerScroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (max-width: 749px) {
    .feature-ticker { padding: 20px 0; }
  }
</style>

{% schema %}
{
  "name": "Feature Ticker",
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "🐾" },
        { "type": "text", "id": "text", "label": "Text", "default": "No-Pull Design" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Feature Ticker",
      "blocks": [
        { "type": "item", "settings": { "icon": "🐾", "text": "No-Pull Design" } },
        { "type": "item", "settings": { "icon": "🧼", "text": "Machine Washable" } },
        { "type": "item", "settings": { "icon": "🌙", "text": "Reflective Strips" } },
        { "type": "item", "settings": { "icon": "📏", "text": "Fits XS–XL" } },
        { "type": "item", "settings": { "icon": "✅", "text": "30-Day Guarantee" } }
      ]
    }
  ]
}
{% endschema %}