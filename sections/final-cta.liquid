<div class="final-cta">
  <div class="final-cta__inner">
    <h2 class="final-cta__heading">{{ section.settings.heading }}</h2>
    <p class="final-cta__text">{{ section.settings.text }}</p>

    <div class="final-cta__price-row">
      <span class="final-cta__compare-price">{{ section.settings.compare_price }}</span>
      <span class="final-cta__price">{{ section.settings.price }}</span>
    </div>

    <a href="{{ section.settings.button_link }}" class="final-cta__button">{{ section.settings.button_label }}</a>

    <p class="final-cta__trust">{{ section.settings.trust_text }}</p>
  </div>
</div>

<style>
  .final-cta {
    background: #3E2F23;
    padding: 56px 24px;
    font-family: 'Work Sans', sans-serif;
    text-align: center;
  }

  .final-cta__inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .final-cta__heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    color: #fff;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .final-cta__text {
    font-size: 15.5px;
    line-height: 1.55;
    color: #E8D5BE;
    margin: 0 0 24px;
  }

  .final-cta__price-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .final-cta__compare-price {
    font-size: 15px;
    color: #B08968;
    text-decoration: line-through;
  }

  .final-cta__price {
    font-family: 'Fraunces', serif;
    font-size: 30px;
    font-weight: 700;
    color: #fff;
  }

  .final-cta__button {
    display: block;
    width: 100%;
    background: #D97B4F;
    color: #fff;
    font-size: 16.5px;
    font-weight: 700;
    text-align: center;
    padding: 16px 24px;
    border-radius: 10px;
    text-decoration: none;
    box-shadow: 0 10px 22px -8px rgba(217, 123, 79, 0.5);
    transition: background 0.15s ease, transform 0.15s ease;
    box-sizing: border-box;
  }

  .final-cta__button:hover {
    background: #C56A3E;
    transform: translateY(-1px);
  }

  .final-cta__trust {
    margin: 14px 0 0;
    font-size: 12.5px;
    color: #B08968;
  }

  @media (max-width: 749px) {
    .final-cta { padding: 20px 16px; }
  }
</style>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready for calmer walks?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join 2,400+ dog parents who made the switch. Founding customer pricing ends soon." },
    { "type": "text", "id": "price", "label": "Price", "default": "$34.95" },
    { "type": "text", "id": "compare_price", "label": "Compare-at price", "default": "$49.95" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Save 30% Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "trust_text", "label": "Trust line", "default": "30-day guarantee · Free shipping" }
  ],
  "presets": [
    { "name": "Final CTA" }
  ]
}
{% endschema %}