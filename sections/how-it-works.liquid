<div class="how-it-works">
  <div class="how-it-works__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="how-it-works__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="how-it-works__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="how-it-works__grid">
      {% assign step_number = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          {% assign step_number = step_number | plus: 1 %}
          <div class="how-it-works__item" {{ block.shopify_attributes }}>
            <div class="how-it-works__media">
              {% if block.settings.image %}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'how-it-works__image' }}
              {% else %}
                <img class="how-it-works__image" src="https://images.unsplash.com/photo-1555265626-8ed04bde01a1?w=600&q=80&auto=format&fit=crop" alt="Step {{ step_number }}">
              {% endif %}
              <span class="how-it-works__number">{{ step_number }}</span>
            </div>
            <h3 class="how-it-works__label">{{ block.settings.label }}</h3>
            <p class="how-it-works__text">{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .how-it-works {
    background: #fff;
    padding: 56px 24px;
    font-family: 'Work Sans', sans-serif;
  }

  .how-it-works__inner {
    max-width: 1080px;
    margin: 0 auto;
    text-align: center;
  }

  .how-it-works__eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #B5764C;
    margin: 0 0 10px;
  }

  .how-it-works__heading {
    font-family: 'Fraunces', serif;
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    color: #3E2F23;
    margin: 0 0 40px;
    line-height: 1.2;
  }

  .how-it-works__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .how-it-works__item {
    text-align: left;
  }

  .how-it-works__media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    margin-bottom: 16px;
  }

  .how-it-works__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .how-it-works__number {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #D97B4F;
    color: #fff;
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 14px;
    border-radius: 50%;
    box-shadow: 0 6px 14px rgba(217, 123, 79, 0.4);
  }

  .how-it-works__label {
    font-size: 16.5px;
    font-weight: 700;
    color: #3E2F23;
    margin: 0 0 6px;
  }

  .how-it-works__text {
    font-size: 14px;
    line-height: 1.5;
    color: #6B5842;
    margin: 0;
  }

  @media (max-width: 749px) {
    .how-it-works { padding: 20px 16px; }
    .how-it-works__heading { margin-bottom: 28px; }
    .how-it-works__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Getting started" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "On in seconds. No struggle." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Step image" },
        { "type": "text", "id": "label", "label": "Step title", "default": "Slip it on" },
        { "type": "text", "id": "text", "label": "Step description", "default": "Guide their front legs through and clip the buckle." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "How It Works",
      "blocks": [
        { "type": "step", "settings": { "label": "Slip it on", "text": "Guide their front legs through and clip the buckle." } },
        { "type": "step", "settings": { "label": "Adjust the fit", "text": "Tighten the straps until it's snug but not tight." } },
        { "type": "step", "settings": { "label": "Clip and go", "text": "Attach the leash to the front ring and head out." } }
      ]
    }
  ]
}
{% endschema %}